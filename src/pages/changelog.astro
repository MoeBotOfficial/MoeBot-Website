---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
const updates = [
  {version:'0.8.6',date:'当前后端 / WebUI',title:'关键词标签与命令面板',items:['关键词支持群聊与私聊，Markdown 按声明提取动态标签。','关键词组可以声明斜杠命令与说明，保存部署后同步命令面板。','首次安装默认 /sys、/help 关键词，无预装插件；升级恢复已有安装集合。'],link:'/docs/keyword-replies/'},
  {version:'0.8.5',date:'后端 / WebUI',title:'MCP 自动续办',items:['模型预约工具后，由后端自动发起经过鉴权的续办请求。','回复窗口不足或自动续办失败时保留待办，下一条同会话消息继续。','一次任务调用一个工具，并进行一次结果整理。'],link:'/docs/mcp/'},
  {version:'0.8.1',date:'SDK 1.4.0',title:'Markdown 按钮与互动回调',items:['插件可声明并获得 Markdown 按钮授权，默认关闭。','支持指令按钮和回调按钮；回调数据由核心签名并验证。','需要 QQ 平台的相应按钮权限和互动事件订阅。'],link:'/docs/developers/markdown-demo/'},
  {version:'0.8.0',date:'后端 / WebUI',title:'插件 Markdown 消息',items:['插件通过 ctx.reply.markdown 发送格式化消息，需管理员显式授权。','Markdown 与其他回复共用命令回复预算，不写入 AI 聊天历史。'],link:'/docs/developers/sdk/'},
];
---
<Base title="更新记录" description="MoeBot 当前版本与重要功能变化：关键词标签、命令面板、MCP 自动续办、Markdown 消息与按钮。"><main id="main" class="container page-content"><div class="page-intro"><span class="pill">更新记录</span><h1>每一步，都让猫猫更好用。</h1><p>这里记录当前版本与重要变化。升级前请阅读相关文档，确认核心、WebUI 与插件兼容性。</p></div><div class="timeline">{updates.map(u=><article class="timeline-entry"><div class="timeline-version">{u.version}<small>{u.date}</small></div><div class="timeline-body"><h2>{u.title}</h2><ul>{u.items.map(i=><li>{i}</li>)}</ul><a class="text-link" href={u.link}>阅读相关文档 <Icon name="arrow" size={17}/></a></div></article>)}</div><p><a class="text-link" href="/docs/upgrades/">已有实例如何保留配置升级 <Icon name="arrow" size={18}/></a></p></main></Base>
